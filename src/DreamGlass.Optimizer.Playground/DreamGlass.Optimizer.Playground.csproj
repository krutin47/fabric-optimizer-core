<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>DreamGlass.Playground</AssemblyName>
    <RootNamespace>DreamGlass.Optimizer.Playground</RootNamespace>
  </PropertyGroup>

  <!-- Download-and-run packages (scripts/package-apps.sh publishes with -r <rid>): one self-contained program file that
       needs no .NET installed, plus the wwwroot page files next to it. Invariant globalization keeps numbers and text
       identical on every computer's language settings and removes the ICU dependency on Linux. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DreamGlass.Optimizer\DreamGlass.Optimizer.csproj" />
  </ItemGroup>

</Project>
